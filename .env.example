NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_APP_URL=https://www.lien-bio.site

# PayDunya Payment Gateway (https://paydunya.com)
# En production réelle (PRO/LIVE), utilisez vos clés de production et PAYDUNYA_MODE=live
PAYDUNYA_MASTER_KEY=your_paydunya_master_key
PAYDUNYA_PRIVATE_KEY=your_paydunya_private_key
PAYDUNYA_TOKEN=your_paydunya_token
PAYDUNYA_MODE=live # "live" pour la production réelle (PayDunya Pro), ou "test" pour la sandbox

# Maketou Payment Gateway (https://docs-api.maketou.com)
# Obtenez votre clé API sur https://app.maketou.com (Autres > Clés API)
MAKETOU_API_KEY=your_maketou_api_key_here
MAKETOU_API_URL=https://api.maketou.net
# ID de documents produits créés sur Maketou pour chaque plan
MAKETOU_PRODUCT_ID_MONTHLY=your_maketou_monthly_product_document_id
MAKETOU_PRODUCT_ID_YEARLY=your_maketou_yearly_product_document_id
MAKETOU_PRODUCT_ID_LIFETIME=your_maketou_lifetime_product_document_id
