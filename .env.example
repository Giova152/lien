NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_APP_URL=https://www.lien-bio.site

# PayDunya Payment Gateway (https://paydunya.com)
PAYDUNYA_MASTER_KEY=your_paydunya_master_key
PAYDUNYA_PRIVATE_KEY=your_paydunya_private_key
PAYDUNYA_TOKEN=your_paydunya_token
PAYDUNYA_MODE=live

# Chariow Payment Gateway (https://chariow.dev)
# Clé API générée depuis app.chariow.com (Paramètres > Clés API)
CHARIOW_API_KEY=your_chariow_api_key_here
CHARIOW_BASE_URL=https://api.chariow.com/v1
# Secret webhook Pulse (Automations > Pulses > Secret de signature)
CHARIOW_PULSE_SECRET=whsec_your_pulse_secret_here
# ID ou slug de produit Chariow pour chaque formule
CHARIOW_PRODUCT_ID_MONTHLY=prd_your_monthly_product_id
CHARIOW_PRODUCT_ID_YEARLY=prd_your_yearly_product_id
CHARIOW_PRODUCT_ID_LIFETIME=prd_your_lifetime_product_id
